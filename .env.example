
# ============================================================
# Configuração de ambiente
# ============================================================

# DEVELOPMENT, PRODUCTION ou MIGRATE
MODE=DEVELOPMENT

WEB_CONCURRENCY=4

# Nunca compartilhe a chave secreta real do Django.
SECRET_KEY=django_insecure_gere_uma_chave_secreta

# True em desenvolvimento; False em produção.
DEBUG=True
EXPOSE_VERIFICATION_CODE=True

# ============================================================
# Banco de dados
# ============================================================

# Desenvolvimento: SQLite, usado quando DATABASE_URL não existe.
#
# Produção no Fabroku: o valor real de DATABASE_URL deve ser
# configurado nas variáveis de ambiente da aplicação.
#
# Exemplo ilustrativo:
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# ============================================================
# Frontend
# ============================================================

FRONTEND_URLS=http://localhost:5174,http://127.0.0.1:5174

# Exemplo publicado:
# FRONTEND_URLS=https://meu-projeto.class.fabricadesoftware.ifc.edu.br

# ============================================================
# Cloudinary (opcional)
# ============================================================

# Substitua pelos dados reais apenas no ambiente privado.
# Não coloque credenciais reais neste arquivo de exemplo.
CLOUDINARY_URL=cloudinary://134316684982428:tt_U7BbFIdNq4EvMOr2q76Afe2w@yafmrfut
